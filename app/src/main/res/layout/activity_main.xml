<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WT-80B Bluetooth Printer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="สถานะ: ยังไม่ได้เชื่อมต่อ"
            android:textColor="#B00020"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/refreshDevicesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="โหลดรายชื่ออุปกรณ์ที่จับคู่ (Paired Devices)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="เลือกเครื่องพิมพ์ (ต้อง Pair ผ่านตั้งค่า Bluetooth ของโทรศัพท์ก่อน):" />

        <Spinner
            android:id="@+id/deviceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="เชื่อมต่อเครื่องพิมพ์" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ข้อความที่จะพิมพ์ (รองรับภาษาไทย):" />

        <EditText
            android:id="@+id/customTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:hint="พิมพ์ข้อความ เช่น ใบเสร็จรับเงิน ร้านค้าตัวอย่าง"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/printTextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="พิมพ์ข้อความนี้" />

        <Button
            android:id="@+id/printSampleReceiptButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="พิมพ์ใบเสร็จตัวอย่าง" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ข้อมูลบาร์โค้ด (CODE128):" />

        <EditText
            android:id="@+id/barcodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="เช่น 1234567890"
            android:inputType="text" />

        <Button
            android:id="@+id/printBarcodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="พิมพ์บาร์โค้ด" />

        <Button
            android:id="@+id/feedPaperButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ป้อนกระดาษ (Feed)" />

    </LinearLayout>
</ScrollView>
